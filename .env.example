# Application
ECOMMERCE_ANALYST_ENV=local
ECOMMERCE_ANALYST_LOG_LEVEL=INFO

# LLM configuration
# Use "none" for local foundation checks that do not call an LLM.
ECOMMERCE_ANALYST_LLM_PROVIDER=none
ECOMMERCE_ANALYST_LLM_MODEL=
ECOMMERCE_ANALYST_LLM_API_KEY=

# Data directories
ECOMMERCE_ANALYST_RAW_DATA_DIR=data/raw
ECOMMERCE_ANALYST_PROCESSED_DATA_DIR=data/processed
ECOMMERCE_ANALYST_SAMPLE_DATA_DIR=data/sample
ECOMMERCE_ANALYST_MAX_UPLOAD_SIZE_BYTES=10485760
